  "src/labels.py": "import time\n\ndef build_labels(orders):\n    labels=[]\n    for order in orders[:12]:\n        time.sleep(0.001)\n        labels.append({'order':order['order'], 'label':f\"Ship {order['order']} to {order['postcode']}\"})\n    return labels\n",
